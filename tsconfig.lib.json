{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["lib/**/*.js", "bin/**/*.js"],
  "exclude": ["lib/client-src/**", "lib/redteam/client.js", "node_modules"]
}
